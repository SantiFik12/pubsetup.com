{% extends 'admin/base.html.twig' %}
{% block title %}{{ module.name }}{% endblock %}
{% block content %}
<a class="back-link" href="{{ path('admin_dashboard',{vendor:module.partner_id}) }}">Модули вендора</a>
<div class="page-heading"><div><div class="eyebrow">МОДУЛЬ</div><h1>{{ module.name }}</h1><p class="muted">Содержимое и SEO формируются автоматически из страницы вендора.</p></div>{% if module.published %}<a class="button" href="/extension/{{ module.slug }}" target="_blank" rel="noopener">Посмотреть на сайте</a>{% endif %}</div>
{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
<div class="module-edit-sections">
<section class="panel edit-panel source-panel"><div class="source-panel-copy"><h2>Обновление из источника</h2><p class="muted small">Upload обновляет название, описания, цену в USD, рейтинг, отзывы, изображения, возможности, совместимость, руководство и SEO. Affiliate-ссылка, адрес карточки, публикация и счётчики сохраняются.</p>{% if module.source_updated_at %}<p class="muted small">Последняя загрузка: {{ module.source_updated_at|date('d.m.Y H:i') }}</p>{% endif %}</div><form method="post" action="{{ path('admin_module_upload',{id:module_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('upload_' ~ module_id) }}"><button class="button" type="submit">Upload из источника</button></form></section>
<form method="post" class="panel edit-panel form-stack">
<input type="hidden" name="_token" value="{{ csrf_token('module_' ~ module_id) }}">
<h2>Настройки модуля</h2>
<label>Вендор<select name="partner_id" required>{% for vendor in vendors %}<option value="{{ vendor.id }}" {{ vendor.id == module.partner_id ? 'selected' : '' }}>{{ vendor.name }}</option>{% endfor %}</select></label>
<label>Оригинальная ссылка<input type="url" name="original_url" value="{{ module.original_url }}" maxlength="2048" required><span class="hint">По этой ссылке загружаются данные при Upload.</span></label>
<label>Моя affiliate-ссылка<input type="url" name="affiliate_url" value="{{ module.affiliate_url }}" maxlength="2048"><span class="hint">Если поле пустое, используется affiliate-настройка вендора.</span></label>
<label class="check-label"><input type="checkbox" name="published" value="1" {{ module.published ? 'checked' : '' }}>Опубликовать в каталоге</label>
<div class="form-footer"><button class="button primary" type="submit">Сохранить настройки</button></div>
</form>
<section class="panel edit-panel source-panel"><div class="source-panel-copy"><h2>Удаление модуля</h2><p class="muted small">Удаляет карточку и статистику переходов. Модули с заказами можно снять с публикации.</p></div><a class="button danger" href="{{ path('admin_module_delete',{id:module_id}) }}">Удалить модуль</a></section>
</div>
{% endblock %}
