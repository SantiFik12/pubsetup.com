{% extends 'admin/base.html.twig' %}
{% block content %}
<div class="page-heading"><div><div class="eyebrow">КАТАЛОГ</div><h1>{{ selected ? selected.name : 'Модули' }}</h1><p class="muted">{{ selected ? 'Модули и переходы выбранного вендора.' : 'Управляйте предложениями партнёров в одном месте.' }}</p></div><div class="heading-actions">{% if selected %}<a class="button" href="{{ path('admin_vendor_edit',{id:selected.id}) }}">Настройки вендора</a>{% endif %}<a class="button primary" href="{{ path('admin_module_new', selected ? {vendor:selected.id} : {}) }}">Добавить модуль</a></div></div>
<div class="stats-grid"><article class="stat"><span>Вендоры</span><strong>{{ totals.vendors }}</strong></article><article class="stat"><span>Модули</span><strong>{{ totals.modules }}</strong></article><article class="stat"><span>Открытия карточек</span><strong>{{ totals.module_clicks }}</strong></article><article class="stat"><span>Affiliate-переходы</span><strong>{{ totals.affiliate_clicks }}</strong></article></div>
<section class="panel"><div class="panel-toolbar"><div><h2>{{ selected ? 'Модули вендора' : 'Все модули' }}</h2><span class="muted small">{{ modules|length }} в списке</span></div><form class="search-form" method="get" action="{{ path('admin_dashboard') }}">{% if selected %}<input type="hidden" name="vendor" value="{{ selected.id }}">{% endif %}<label class="sr-only" for="module-search">Поиск по названию</label><input id="module-search" type="search" name="q" value="{{ query }}" placeholder="Найти модуль…"><button class="button" type="submit">Найти</button></form></div>
{% if modules %}<div class="table-scroll"><table><thead><tr><th>Модуль</th><th>Вендор / цена</th><th>Открытия</th><th>Переходы</th><th>Статус</th><th>Действия</th></tr></thead><tbody>{% for module in modules %}<tr>
<td><div class="module-cell">{% if module.cover_image %}<img class="module-cover" src="{{ module.cover_image }}" alt="">{% endif %}<div class="module-text"><a class="module-title" href="{{ path('admin_module_edit',{id:module.id}) }}">{{ module.name }}</a><a class="source-link" href="{{ module.original_url }}" target="_blank" rel="noopener noreferrer">{{ module.original_url|replace({'https://':'','http://':''}) }}</a></div></div></td>
<td><strong class="small">{{ module.vendor }}</strong><div class="muted small">${{ module.price_from|number_format(2,'.','') }}</div></td><td class="metric">{{ module.module_clicks }}</td><td class="metric">{{ module.affiliate_clicks }}</td><td><span class="status {{ module.published ? 'published' : 'draft' }}">{{ module.published ? 'Опубликован' : 'Черновик' }}</span></td>
<td><div class="row-actions"><a class="button small-button" href="{{ path('admin_module_edit',{id:module.id}) }}">Изменить</a><form method="post" action="{{ path('admin_module_upload',{id:module.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('upload_' ~ module.id) }}"><button class="button small-button" type="submit" title="Обновить данные по ссылке оригинального модуля">Upload</button></form></div>{% if module.source_updated_at %}<div class="muted tiny">Источник: {{ module.source_updated_at|date('d.m.Y H:i') }}</div>{% endif %}</td>
</tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><h3>Здесь пока нет модулей</h3><p class="muted">{{ query ? 'Попробуйте другое название или сбросьте поиск.' : 'Добавьте вендора и его первый модуль, указав оригинальную и affiliate-ссылки.' }}</p><a class="button" href="{{ path('admin_vendor_new') }}">Добавить вендора</a></div>{% endif %}</section>
<p class="footnote">Открытия и переходы считаются отдельно. Это количество обращений по ссылкам, а не уникальные посетители. Upload обновляет данные из источника, сохраняя вашу affiliate-ссылку.</p>
{% endblock %}
