{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pubsetup-dev",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.js",
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "no_bundle": true,
  "env": {
    "production": {
      "name": "pubsetup",
      "compatibility_date": "2025-09-24",
      "compatibility_flags": ["nodejs_compat"],
      "main": "dist/server/index.js",
      "assets": {
        "directory": "dist/client"
      },
      "rules": [
        {
          "type": "ESModule",
          "globs": ["**/*.js", "**/*.mjs"]
        }
      ],
      "no_bundle": true
    },
    "develop": {
      "name": "pubsetup-dev",
      "compatibility_date": "2025-09-24",
      "compatibility_flags": ["nodejs_compat"],
      "main": "dist/server/index.js",
      "assets": {
        "directory": "dist/client"
      },
      "rules": [
        {
          "type": "ESModule",
          "globs": ["**/*.js", "**/*.mjs"]
        }
      ],
      "no_bundle": true
    }
  }
}
