{% extends 'admin/base.html.twig' %}
{% block title %}{{ module_id ? module.name : 'Новый модуль' }}{% endblock %}
{% block content %}
<a class="back-link" href="{{ path('admin_dashboard',module.partner_id ? {vendor:module.partner_id} : {}) }}">Модули вендора</a>
<div class="page-heading"><div><div class="eyebrow">МОДУЛЬ</div><h1>{{ module_id ? 'Редактирование модуля' : 'Добавить модуль' }}</h1><p class="muted">Данные загружаются по ссылке. Для повторной загрузки нажмите Upload.</p></div>{% if module_id and module.published %}<a class="button" href="/extension/{{ module.slug }}" target="_blank" rel="noopener">Посмотреть на сайте</a>{% endif %}</div>
{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
{% if not vendors %}<div class="notice"><a href="{{ path('admin_vendor_new') }}">Сначала добавьте вендора</a>.</div>{% endif %}
<div class="module-edit-sections">
{% if module_id %}<section class="panel edit-panel source-panel"><div class="source-panel-copy"><h2>Обновление из оригинального модуля</h2><p class="muted small">Upload читает название, описания, цену в USD, рейтинг, главное фото, галерею и README / User Guide по сохранённой оригинальной ссылке. Публикация, ваша affiliate-ссылка и статистика не меняются.</p></div><form method="post" action="{{ path('admin_module_upload',{id:module_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('upload_' ~ module_id) }}"><button class="button" type="submit">Upload из источника</button></form></section>{% endif %}

<details class="panel edit-panel"><summary>Ручная корректировка (необязательно)</summary>
<form method="post" enctype="multipart/form-data" class="module-editor"><input type="hidden" name="_token" value="{{ csrf_token('module_' ~ (module_id ?? 'new')) }}">
<div class="editor-main">
<section class="panel edit-panel form-stack"><h2>Основная информация</h2><label>Название модуля<input name="name" value="{{ module.name }}" maxlength="250" required></label><div class="form-grid"><label>Вендор<select name="partner_id" required><option value="">Выберите вендора</option>{% for vendor in vendors %}<option value="{{ vendor.id }}" {{ vendor.id == module.partner_id ? 'selected' : '' }}>{{ vendor.name }}</option>{% endfor %}</select></label><label>Категория<select name="category_id" required><option value="">Выберите категорию</option>{% for category in categories %}<option value="{{ category.id }}" {{ category.id == module.category_id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label></div><label>Slug<input name="slug" value="{{ module.slug }}" maxlength="150" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="Создаётся из названия"><span class="hint">Адрес подробной страницы: /extension/slug</span></label><label>Краткое описание<textarea name="short_description" rows="3" maxlength="2000">{{ module.short_description }}</textarea></label><label>Полное описание<textarea name="description" rows="7" maxlength="30000">{{ module.description }}</textarea></label><label>Возможности модуля<textarea name="features" rows="4" maxlength="10000" placeholder="Каждая возможность с новой строки">{{ module.features }}</textarea></label><label>Теги<input name="tags" value="{{ module.tags }}" maxlength="2000" placeholder="ccpa, privacy, hyva"></label></section>
<section class="panel edit-panel form-stack"><h2>Изображения</h2><p class="muted small">Одно главное фото в каталоге; дополнительные скриншоты — в галерее модуля. JPG, PNG или WebP, до 8 МБ на файл.</p>{% if module.cover_image %}<img class="cover-preview" src="{{ module.cover_image }}" alt="Текущая обложка">{% endif %}<label>Загрузить главное фото<input type="file" name="cover_upload" accept="image/jpeg,image/png,image/webp"></label><label>Путь или URL обложки<input name="cover_image" value="{{ module.cover_image }}" maxlength="2048" placeholder="/images/extensions/module/cover.png"></label><label>Загрузить дополнительные скриншоты<input type="file" name="gallery_uploads[]" accept="image/jpeg,image/png,image/webp" multiple><span class="hint">До 8 изображений за один раз. Добавляются к текущей галерее.</span></label><label>Изображения галереи<textarea name="gallery" rows="4" maxlength="20000" placeholder="Каждая ссылка с новой строки">{{ module.gallery }}</textarea></label></section>
</div>
<aside class="editor-side">
<section class="panel edit-panel form-stack"><h2>Ссылки</h2><label>Оригинальный модуль<input type="url" name="original_url" value="{{ module.original_url }}" maxlength="2048" required placeholder="https://vendor.com/module.html"></label><label>Моя affiliate-ссылка<input type="url" name="affiliate_url" value="{{ module.affiliate_url }}" maxlength="2048" placeholder="https://vendor.com/module.html?ref=..."></label><label>README / User Guide<input type="url" name="user_guide_url" value="{{ module.user_guide_url }}" maxlength="2048"></label></section>
<section class="panel edit-panel form-stack"><h2>SEO</h2><p class="muted small">Заполняется автоматически при импорте и Upload. При необходимости можно скорректировать вручную.</p><label>SEO title<input name="seo_title" value="{{ module.seo_title|default('') }}" maxlength="65"><span class="hint">До 65 символов. Отдельно от названия модуля.</span></label><label>SEO description<textarea name="seo_description" rows="4" maxlength="160">{{ module.seo_description|default('') }}</textarea><span class="hint">До 160 символов, законченными предложениями.</span></label></section>
<section class="panel edit-panel form-stack"><h2>Цена и совместимость</h2><div class="form-grid"><label>Цена партнёра, $<input type="number" name="price_from" min="0" max="99999999.99" step="0.01" value="{{ module.price_from }}" required></label><label>Тип цены<select name="price_type">{% for value,label in {'one-time':'Разовая','subscription':'Подписка','free':'Бесплатно'} %}<option value="{{ value }}" {{ module.price_type == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label></div><label>Установка, $<input type="number" name="install_price" min="0" max="99999999.99" step="0.01" value="{{ module.install_price }}" required></label><label>Версии Magento<input name="magento_versions" value="{{ module.magento_versions }}" maxlength="500" placeholder="2.4.7, 2.4.8"></label><label class="check-label"><input type="checkbox" name="hyva_compatible" value="1" {{ module.hyva_compatible ? 'checked' : '' }}> Совместим с Hyvä</label><label class="check-label"><input type="checkbox" name="published" value="1" {{ module.published ? 'checked' : '' }}> Опубликовать в каталоге</label><button class="button primary full" type="submit">Сохранить модуль</button></section>
</aside>
</form>
</details>
{% if module_id %}<section class="panel edit-panel source-panel"><div class="source-panel-copy"><h2>Удаление модуля</h2><p class="muted small">Удаляет карточку и статистику переходов. Модули с заказами можно снять с публикации.</p></div><a class="button danger" href="{{ path('admin_module_delete',{id:module_id}) }}">Удалить модуль</a></section>{% endif %}
</div>
{% endblock %}
