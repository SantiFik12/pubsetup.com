# Replace preview.example.com with the temporary hostname and set a caddy hash-password hash.
preview.example.com {
    basic_auth {
        preview REPLACE_WITH_CADDY_PASSWORD_HASH
    }
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
}

