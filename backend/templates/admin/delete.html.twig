{% extends 'admin/base.html.twig' %}
{% set is_vendor = kind == 'vendor' %}
{% set edit_route = is_vendor ? 'admin_vendor_edit' : 'admin_module_edit' %}
{% block title %}{{ is_vendor ? 'Удаление вендора' : 'Удаление модуля' }}{% endblock %}
{% block content %}
<a class="back-link" href="{{ path(edit_route,{id:record.id}) }}">Вернуться к редактированию</a>
<div class="page-heading"><div><h1>{{ is_vendor ? 'Удалить вендора?' : 'Удалить модуль?' }}</h1><p class="muted">{{ record.name }}</p></div></div>
{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
<section class="panel edit-panel form-stack">
{% if record.dependencies > 0 %}
    {% if is_vendor %}<p>У вендора есть модули: {{ record.dependencies }}. Сначала удалите их или перенесите к другому вендору в ручной корректировке модуля.</p>
    {% else %}<p>Модуль связан с заказами: {{ record.dependencies }}. Чтобы сохранить историю заказов, удаление недоступно. Снимите флажок «Опубликовать в каталоге» в ручной корректировке модуля.</p>{% endif %}
    <a class="button" href="{{ path(edit_route,{id:record.id}) }}">Вернуться к редактированию</a>
{% else %}
    <p>{{ is_vendor ? 'Вендор будет удалён из каталога.' : 'Модуль и его статистика переходов будут удалены из каталога. Его страница перестанет быть доступна.' }} Восстановить запись через панель нельзя.</p>
    <form method="post" class="form-stack">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ kind ~ '_' ~ record.id) }}">
        <label class="check-label"><input type="checkbox" name="confirm" value="delete" required> Подтверждаю удаление «{{ record.name }}»</label>
        <div class="form-footer"><a class="button" href="{{ path(edit_route,{id:record.id}) }}">Отмена</a><button class="button danger" type="submit">{{ is_vendor ? 'Удалить вендора' : 'Удалить модуль' }}</button></div>
    </form>
{% endif %}
</section>
{% endblock %}
