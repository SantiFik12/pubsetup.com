{
    "name": "pubsetup/backend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "qa": [
            "@qa:phpstan",
            "@qa:cs-fixer",
            "@qa:rector",
            "@php bin/console lint:yaml config",
            "@php bin/console lint:twig templates",
            "@php bin/console lint:container",
            "@php tests/run.php",
            "@php tests/email.php",
            "@php tests/orders.php",
            "@php tests/importer.php",
            "@php tests/affiliate.php",
            "@php tests/catalog-delete.php",
            "@php tests/admin.php"
        ],
        "qa:phpstan": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "qa:cs-fixer": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "qa:rector": "@php vendor/bin/rector process --dry-run --no-progress-bar",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix --sequential",
        "rector:fix": "@php vendor/bin/rector process --no-progress-bar"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7"
    }
}
