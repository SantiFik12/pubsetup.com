{% extends 'admin/base.html.twig' %}
{% block title %}{{ vendor_id ? 'Редактирование вендора' : 'Новый вендор' }}{% endblock %}
{% block content %}
<a class="back-link" href="{{ path('admin_dashboard') }}">Все модули</a><div class="page-heading"><div><div class="eyebrow">ВЕНДОРЫ</div><h1>{{ vendor_id ? 'Настройки вендора' : 'Добавить вендора' }}</h1><p class="muted">Создайте партнёра, затем добавьте его модули.</p></div></div>
{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
<form method="post" class="panel edit-panel form-stack"><input type="hidden" name="_token" value="{{ csrf_token('vendor_' ~ (vendor_id ?? 'new')) }}"><div class="form-grid"><label>Название<input name="name" value="{{ vendor.name }}" maxlength="200" required placeholder="Например, Amasty"></label><label>Slug<input name="slug" value="{{ vendor.slug }}" maxlength="150" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="amasty"><span class="hint">Можно оставить пустым — создадим из названия.</span></label></div><label>Сайт вендора<input type="url" name="website" value="{{ vendor.website }}" maxlength="2048" placeholder="https://amasty.com"></label><label>Описание<textarea name="description" rows="5" maxlength="10000">{{ vendor.description }}</textarea></label><div class="form-footer"><a class="button" href="{{ path('admin_dashboard') }}">Отмена</a><button class="button primary" type="submit">Сохранить вендора</button></div></form>
{% if vendor_id %}<section class="panel edit-panel form-stack"><h2>Удаление вендора</h2><p class="muted small">Удаление доступно, когда у вендора не осталось модулей.</p><a class="button danger" href="{{ path('admin_vendor_delete',{id:vendor_id}) }}">Удалить вендора</a></section>{% endif %}
{% endblock %}
