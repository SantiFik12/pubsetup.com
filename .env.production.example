COMPOSE_PROJECT_NAME=pubsetup-prod
RELEASE_TAG=initial
HTTP_PORT=8080
SITE_URL=https://pubsetup.com
POSTGRES_DB=pubsetup
POSTGRES_USER=pubsetup
POSTGRES_PASSWORD=generate-with-init-production
APP_DB_PASSWORD=generate-with-init-production
APP_SECRET=generate-with-init-production
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
MAIL_FROM=contact@pubsetup.com
MAIL_NOTIFICATION_TO=contact@pubsetup.com
# Show the section; the login becomes active once its password is configured.
# This password is PUBLIC: use only the dedicated demo_viewer password.
DEMO_ADMIN_ENABLED=1
DEMO_ADMIN_PASSWORD=
